# AWS Console Emulator Configuration

# Active Backend
ACTIVE_BACKEND=localemu
ADAPTER_MODE=localemu

# LocalStack Configuration
LOCALSTACK_HOSTNAME=localhost
LOCALSTACK_EDGE_PORT=4566
LOCALSTACK_ENDPOINT=http://localhost:4566
LOCALSTACK_SSL_ENABLED=false

# MiniStack Configuration
MINSTACK_HOSTNAME=localhost
MINSTACK_EDGE_PORT=4566
MINSTACK_ENDPOINT=http://localhost:4566
MINSTACK_SSL_ENABLED=false

# LocalEmu Configuration
LOCALEMU_HOSTNAME=localhost
LOCALEMU_EDGE_PORT=4566
LOCALEMU_SSL_ENABLED=false
LOCALEMU_ENDPOINT=http://localhost:4566

# AWS Configuration
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SESSION_TOKEN=
AWS_ACCOUNT_ID=000000000000
AWS_ENDPOINT_URL=http://localhost:4566

# Root User Credentials (for local development)
NEXT_PUBLIC_ROOT_USERNAME=root
NEXT_PUBLIC_ROOT_PASSWORD=root123

# Public Endpoints (exposed to browser)
NEXT_PUBLIC_LOCALSTACK_ENDPOINT=http://localhost:4566
NEXT_PUBLIC_MINSTACK_ENDPOINT=http://localhost:4566
NEXT_PUBLIC_LOCALEMU_ENDPOINT=http://localhost:4566

# Application Configuration
NEXT_PUBLIC_APP_TITLE=Local AWS Emulator Console
NEXT_PUBLIC_APP_VERSION=0.1.0

# Database
DATABASE_PATH=data/console.db
DATABASE_URL=file:./data/console.db

# MFA
MFA_ENABLED=false
MFA_TOTP_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5
