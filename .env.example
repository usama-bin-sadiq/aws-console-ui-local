# AWS Console Emulator Configuration

# Active Backend
ACTIVE_BACKEND=localstack

# LocalStack Configuration
LOCALSTACK_HOSTNAME=localhost
LOCALSTACK_EDGE_PORT=4566
LOCALSTACK_ENDPOINT=http://localhost:4566
LOCALSTACK_SSL_ENABLED=false

# MiniStack Configuration
MINSTACK_HOSTNAME=localhost
MINSTACK_EDGE_PORT=4566
MINSTACK_ENDPOINT=http://localhost:4566
MINSTACK_SSL_ENABLED=false

# AWS Configuration
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SESSION_TOKEN=

# Root User Credentials (for local development)
NEXT_PUBLIC_ROOT_USERNAME=root
NEXT_PUBLIC_ROOT_PASSWORD=root123

# Application Configuration
NEXT_PUBLIC_APP_TITLE=Local AWS Emulator Console
NEXT_PUBLIC_APP_VERSION=0.1.0

# Database
DATABASE_PATH=data/console.db

# MFA
MFA_ENABLED=false
MFA_TOTP_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5
